{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (x86, Debug, dynamic)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAPY_STATIC": "OFF"
      }
    },
    {
      "name": "release-x86",
      "displayName": "Release (x86, static)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release-x86",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAPY_STATIC": "ON"
      }
    },
    {
      "name": "release-arm64",
      "displayName": "Release (ARM64 cross-compile, static)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release-arm64",
      "toolchainFile": "${sourceDir}/toolchain-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAPY_STATIC": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan (x86, debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAPY_STATIC": "OFF",
        "CAPY_ASAN": "ON"
      }
    },
    {
      "name": "asan-arm64",
      "displayName": "ASan (ARM64 cross-compile)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-sanitize-arm64",
      "toolchainFile": "${sourceDir}/toolchain-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAPY_STATIC": "OFF",
        "CAPY_ASAN": "ON"
      }
    },
    {
      "name": "macos-dev",
      "displayName": "macOS Development (arm64, Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CAPY_STATIC": "OFF",
        "CAPY_ASAN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-dev-x86",
      "displayName": "macOS Development (x86_64, Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos-dev-x86",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CAPY_STATIC": "OFF",
        "CAPY_ASAN": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release-x86",
      "configurePreset": "release-x86"
    },
    {
      "name": "release-arm64",
      "configurePreset": "release-arm64"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "asan-arm64",
      "configurePreset": "asan-arm64"
    },
    {
      "name": "macos-dev",
      "configurePreset": "macos-dev"
    },
    {
      "name": "macos-dev-x86",
      "configurePreset": "macos-dev-x86"
    }
  ]
}
